# 两个 Docker 编排都可不创建 .env 直接启动。本文件只列出可选覆盖项。

# ==================== 产品运行配置（可选） ====================

# 产品 Web 的外部访问地址；仅启用 Magic Link / OAuth 时需要。
# PUBLIC_BASE_URL=https://canvas.example.com

# 是否启用演示模式。默认关闭；开启后使用内置演示模型和模拟任务结果。
DEMO_MODE=false

# 加密根密钥会在首次启动时自动生成到 encryption-data 持久卷，无需写入此文件。
# 旧部署的 ENCRYPTION_KEY_V* 会在启动时自动导入 keyring；导入后可从 env 删除。

# ==================== 端口覆盖（可选） ====================

# 正式部署只暴露 Web；开发编排还会把 API、PostgreSQL、Redis 绑定到本机回环地址。
# CANVAS_WEB_PORT=5180
# CANVAS_API_PORT=5181
# POSTGRES_PORT=5433
# REDIS_PORT=6381

# ==================== 镜像源覆盖（可选） ====================

# 默认应用镜像来自 https://cnb.cool/liuxiaogang/xg-canvas 的公开 CNB 制品库。
# 普通部署使用 latest。
# CANVAS_API_IMAGE=docker.cnb.cool/liuxiaogang/xg-canvas/canvas-api:latest
# CANVAS_WEB_IMAGE=docker.cnb.cool/liuxiaogang/xg-canvas/canvas-web:latest

# PostgreSQL/Redis 默认使用 Docker Hub 官方镜像；网络受限时可覆盖为其他可信镜像地址。
# POSTGRES_IMAGE=postgres:18-alpine
# REDIS_IMAGE=redis:8-alpine
