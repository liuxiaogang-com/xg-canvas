{
  "name": "@xgcanvas/model-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned model catalog contracts, compiler, validator and deterministic bundle utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "xgcanvas-model-catalog": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "catalog:check": "node dist/cli.js --config ../../config",
    "catalog:build": "node dist/cli.js --config ../../config --out ../../config/model-catalog.bundle.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@xgcanvas/constraint-engine": "workspace:*",
    "@xgcanvas/shared-types": "workspace:*",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
