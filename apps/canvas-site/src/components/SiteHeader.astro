---
const navItems = [
  { label: '工作流', href: '/#workflow' },
  { label: '产品能力', href: '/#capabilities' },
  { label: '开源', href: '/#open-source' },
  { label: '文档', href: '/docs/' },
];
---

<header class="site-header">
  <div class="shell site-header__inner glass">
    <a class="brand" href="/" aria-label="XG Canvas 首页">
      <span class="brand__name">XG Canvas</span>
      <span class="brand__beta">Beta</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="header-github" href="https://github.com/liuxiaogang-com/xg-canvas" target="_blank" rel="noreferrer">
      GitHub
      <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M5 11 11 5M6 5h5v5" />
      </svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 18px 0 auto;
    z-index: 20;
  }

  .site-header__inner {
    display: grid;
    min-height: 58px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 18px 0 22px;
    border-radius: 999px;
    background: rgba(10, 13, 19, 0.62);
    box-shadow: 0 14px 50px rgba(0, 0, 0, 0.26);
  }

  .brand,
  .header-github {
    display: inline-flex;
    align-items: center;
  }

  .brand {
    justify-self: start;
    gap: 10px;
  }

  .brand__name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand__beta {
    padding: 3px 7px;
    border: 1px solid rgba(45, 212, 191, 0.22);
    border-radius: 999px;
    color: var(--site-accent-bright);
    background: rgba(20, 184, 166, 0.08);
    font-family: var(--site-font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 30px;
    color: var(--site-text-soft);
    font-size: 13px;
  }

  .site-nav a,
  .header-github {
    transition: color 160ms ease;
  }

  .site-nav a:hover,
  .header-github:hover {
    color: var(--site-text);
  }

  .header-github {
    justify-self: end;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .site-header {
      inset-block-start: 10px;
    }

    .site-header__inner {
      grid-template-columns: 1fr auto;
      min-height: 54px;
    }

    .site-nav {
      display: none;
    }
  }
</style>
