{
  "name": "@xgcanvas/canvas-api",
  "version": "0.1.0",
  "private": true,
  "description": "Canvas business backend (workspace/project/task/asset/preset).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "test": "pnpm -w build:workspace-libs && jest --maxWorkers=2",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.0",
    "@xgcanvas/adapters-contract": "workspace:*",
    "@xgcanvas/constraint-engine": "workspace:*",
    "@xgcanvas/shared-types": "workspace:*",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "glob": "^11.0.0",
    "ioredis": "^5.4.0",
    "js-yaml": "^4.1.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "moduleNameMapper": {
      "^@xgcanvas/shared-types$": "<rootDir>/../../../packages/shared-types/src/index.ts",
      "^@xgcanvas/adapters-contract$": "<rootDir>/../../../packages/adapters-contract/src/index.ts",
      "^@xgcanvas/constraint-engine$": "<rootDir>/../../../packages/constraint-engine/src/index.ts"
    }
  }
}
